# Xcode user-specific
xcuserdata/
*.xcuserstate
DerivedData/
build/

# macOS
.DS_Store

# Optional secrets / local junk
*.mov
.env
**/AuthKey_*.p8
# Local Instruments captures
.perf-traces/

# Cloudflare Workers local
node_modules/
.wrangler/
workers/**/dist/

# Local/CI build stamp from set-build-number.sh
ci_scripts/.last_build_number

# Maintainer-only notes (machine paths, Gitea remotes, SSH). Tracked: docs/local/README.md
docs/local/*
!docs/local/README.md
