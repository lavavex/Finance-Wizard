<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Matches Icon Composer file Mika.icon (App Icon name in target settings) -->
	<key>CFBundleIconName</key>
	<string>Mika</string>
	<!-- Export compliance: app does not use custom/non-exempt encryption -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Static system splash (before SwiftUI loads) — brand blue from asset catalog -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plaid is HTTPS; local networking kept permissive for optional offline import tools -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>

