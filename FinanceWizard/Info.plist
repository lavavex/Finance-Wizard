<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Matches Icon Composer file Mika.icon (App Icon name in target settings) -->
	<key>CFBundleIconName</key>
	<string>Mika</string>
	<!-- Export compliance: app does not use custom/non-exempt encryption -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Static system splash (before SwiftUI loads) — system background (light/dark) -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plaid is HTTPS; local networking kept permissive for optional offline import tools -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Hosted Link completion (ASWebAuthenticationSession callback) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>net.roberth.FinanceWizard.hosted-link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>financewizard</string>
			</array>
		</dict>
	</array>

	<!-- Open .fwbackup from Files / iCloud Drive / other apps -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.roberth.FinanceWizard.backup</string>
			<key>UTTypeDescription</key>
			<string>Finance Wizard Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fwbackup</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Finance Wizard Backup</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.roberth.FinanceWizard.backup</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>fwbackup</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
